{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": ["${mod_authors}"],
    "license": "${mod_license}",
    "environment": "*",
    "entrypoints": {
        "main": ["github.mrornithorynque.bmh.fabric.BalancedMcHardcoreFabric"],
        "client": ["github.mrornithorynque.bmh.fabric.BalancedMcHardcoreFabricClient"]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=21"
    }
}
